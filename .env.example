# ==============================================================================
# CAMPUSDESK - Variables de Entorno y Configuración de Despliegue
# TechNova Solutions
# ==============================================================================

# ------------------------------------------------------------------------------
# PUERTOS EXPUESTOS EN EL HOST (Puertos alternativos para evitar colisiones)
# ------------------------------------------------------------------------------
# PostgreSQL (Por defecto 5432, mapeado al host como 5436)
DB_PORT=5436

# Redis (Por defecto 6379, mapeado al host como 6385)
REDIS_HOST_PORT=6385

# Backend REST API Spring Boot (Por defecto 8080/8050, mapeado al host como 8056)
BACKEND_PORT=8056
BACKEND_INTERNAL_PORT=8056

# Frontend Nginx Web Server (Por defecto 80/5500, mapeado al host como 5506)
FRONTEND_PORT=5506

# ------------------------------------------------------------------------------
# CREDENCIALES Y CONFIGURACIÓN DE BASE DE DATOS (campusdesk-db)
# ------------------------------------------------------------------------------
POSTGRES_DB=sistema_gestion_usuarios
POSTGRES_USER=admin
POSTGRES_PASSWORD=CampusDesk_Dev_Pass_2026!

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE REDIS (campusdesk-redis)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CampusDesk_Redis_Pass_2026!
SESSION_TTL_SECONDS=28800

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL BACKEND SPRING BOOT (campusdesk-backend)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# Seguridad JWT (Algoritmo HMAC256 - Secreto de al menos 32 caracteres)
JWT_SECRET=CampusDesk_Secret_Key_2026_Secure_Token_Min32Chars!
JWT_ISSUER=CampusDesk_API
JWT_EXPIRATION_MS=86400000
